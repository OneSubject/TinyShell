# TinyShell Makefile
# Default target is 'help'. Just type `make`.

CC      ?= cc
CFLAGS  ?= -std=c11 -O2 -g -Wall -Wextra
DEFS    ?=
LDFLAGS ?=

# fork(), execvp(), chdir() and friends are POSIX, not C11. -std=c11 on its own
# puts the compiler in strict-ANSI mode, where every non-standard declaration
# is hidden, and the errors that produces ("implicit declaration of function
# 'fork'") are among the most confusing a beginner hits in C. So the feature
# test macro is requested explicitly and kept here where it can be read.
DEFS += -D_POSIX_C_SOURCE=200809L

COLOR_OK    := \033[32m
COLOR_INFO  := \033[36m
COLOR_WARN  := \033[33m
COLOR_RESET := \033[0m

SRC_DIR := src
BUILD_DIR := build
TARGET := $(BUILD_DIR)/tinyshell

SRCS := $(wildcard $(SRC_DIR)/*.c)
OBJS := $(patsubst $(SRC_DIR)/%.c,$(BUILD_DIR)/%.o,$(SRCS))
DEPS := $(OBJS:.o=.d)

.PHONY: all build run clean help
.DEFAULT_GOAL := help

all: build

build: $(TARGET)

$(TARGET): $(OBJS)
	@echo "$(COLOR_OK)[LINK]$(COLOR_RESET) $@"
	$(CC) $(LDFLAGS) -o $@ $(OBJS)

$(BUILD_DIR)/%.o: $(SRC_DIR)/%.c
	@mkdir -p $(dir $@)
	@echo "$(COLOR_OK)[CC]$(COLOR_RESET) $<"
	$(CC) $(DEFS) $(CFLAGS) -MMD -MP -c $< -o $@

# Header dependencies, generated by -MMD above.
-include $(DEPS)

run: $(TARGET)
	@echo "$(COLOR_INFO)[RUN]$(COLOR_RESET)"
	@./$(TARGET)

clean:
	@echo "$(COLOR_WARN)[CLEAN]$(COLOR_RESET) $(BUILD_DIR)"
	rm -rf $(BUILD_DIR)

help:
	@echo ""
	@echo "$(COLOR_INFO)TinyShell targets:$(COLOR_RESET)"
	@echo ""
	@echo "  $(COLOR_OK)make$(COLOR_RESET)          - show this help (default)"
	@echo "  $(COLOR_OK)make build$(COLOR_RESET)    - compile the shell"
	@echo "  $(COLOR_OK)make run$(COLOR_RESET)      - build and run the shell"
	@echo "  $(COLOR_OK)make clean$(COLOR_RESET)    - remove build directory"
	@echo ""
	@echo "$(COLOR_INFO)reading the code:$(COLOR_RESET) README.md has the roadmap."
	@echo ""